{
  "name": "skill-idle",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --mode web --host 127.0.0.1",
    "dev:desktop": "vite --mode desktop --host 127.0.0.1",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "check:quick": "npm run format:check && npm run typecheck && npm run lint",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm run check:architecture && npm run check:content-docs && npm run check:content-json && npm run check:content-keyset && npm run check:theme-contrast",
    "build": "npm run build:web",
    "build:web": "tsc -b && vite build --mode web",
    "build:desktop": "tsc -b && vite build --mode desktop",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:content-docs": "node scripts/check-content-library.mjs",
    "check:content-json": "node scripts/validate-content-json.mjs",
    "check:content-keyset": "node scripts/check-content-keyset.mjs",
    "check:theme-contrast": "node scripts/check-theme-contrast.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tauri-apps/cli": "2.12.1",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "fake-indexeddb": "6.2.5",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
