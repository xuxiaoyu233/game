      "note": "圆角同网格，保证 1px 描边与圆角共享同一条边。",
      "sm": { "value": "0.375rem", "px": 6 },
      "md": { "value": "0.5rem", "px": 8 },
      "lg": { "value": "0.75rem", "px": 12 }
    },
    "font": {
      "note": "行高属于字阶层，不属于组件：--line-title/-heading/-body/-caption，组件内不得再写 line-height 字面量。",
      "title": {
        "value": "1.25rem",
        "px": 20,
        "weight": 600,
        "lineHeight": 1.25,
        "usage": "屏幕级标题（header 产品名、详情页技能名）"
      },
      "heading": {
        "value": "1rem",
        "px": 16,
        "weight": 500,
        "lineHeight": 1.3,
        "usage": "区块标题、页签"
      },
      "body": {
        "value": "0.8rem",
        "px": 12.8,
        "weight": 400,
        "lineHeight": 1.55,
        "usage": "正文、活动名、按钮；中文正文需要比 1.4 更松的基线"
      },
      "caption": {
        "value": "0.7rem",
        "px": 11.2,
        "weight": 400,
        "lineHeight": 1.45,
        "usage": "辅助小字：速率、meta、kicker；不参与层级比例"
      }
    },
    "motion": {
      "fast": { "value": "120ms", "usage": "hover/press 反馈" },
      "base": { "value": "180ms", "usage": "面板出现、页签切换" },
      "slow": { "value": "320ms", "usage": "模式切换、树聚焦飞行的上限" },
      "easeStandard": { "value": "cubic-bezier(0.32, 0.72, 0, 1)", "usage": "位移动画" },
      "easeOutExpo": {
        "value": "cubic-bezier(0.16, 1, 0.3, 1)",
        "usage": "transform/opacity 唯一缓动；禁止 bounce/elastic"
      },
      "constraint": "只动 transform/opacity；尊重 prefers-reduced-motion"
    },
    "progressHeight": {
      "sm": { "value": "5px", "usage": "行内次级进度（SkillRow 经验条）" },
      "md": { "value": "6px", "usage": "StatusBar 与 idle 迷你窗主进度" },
      "lg": { "value": "8px", "usage": "详情页焦点进度" }
